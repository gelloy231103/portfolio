# Copy to .env.local for local development. On Vercel, set these in Project Settings → Environment Variables.

# Supabase project URL and public (anon / publishable) key. Safe to expose: Row Level Security
# only lets this key insert contact messages and read the public "media" bucket.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical site URL used for metadata, sitemap and social previews.
# Optional on Vercel (falls back to the production domain).
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
